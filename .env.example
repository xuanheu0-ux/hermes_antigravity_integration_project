# Copy to `.env` and edit. This file is read by docker compose for interpolation and
# passed into the container through `env_file`. `.env` is gitignored — it may hold keys.
#
# Nothing in this file is a Hermes upstream key; the HERMES_* / OLLAMA_* names below are
# either consumed by this repo's scripts or forwarded into the container (documented
# against the upstream Docker/API-server docs).

# --------------------------------------------------------------------------
# Model provider
# --------------------------------------------------------------------------
# Default = fully local (privacy-first, no API bill). The June 2026 migration in
# 2026-06-02/summary.md moved us off Gemini; keep the cloud key only if you opt back in.
#
# Pick ONE and make it match what's inside the container's config.yaml
# (`docker exec hermes_local cat /opt/data/config.yaml`):
#
#   A) Ollama in this compose stack (recommended, easiest to get right):
#        ./start-hermes.sh --local-llm
#        base_url = http://ollama:11434/v1
#
#   B) Ollama installed on the host:
#        base_url = http://host.docker.internal:11434/v1
#        ...and Ollama MUST listen beyond 127.0.0.1, e.g.
#        OLLAMA_HOST=0.0.0.0 systemctl --user restart ollama
#
#   C) Gemini / any cloud provider: run `docker exec -it hermes_local hermes model`
#        and put the key in the container's own /opt/data/.env (not here).
GEMINI_API_KEY=
# Legacy var kept so an existing .env does not break `docker compose`. Unused by default.
GOOGLE_API_KEY=

# Ollama context window. Hermes sends num_ctx, but the OpenAI-compatible /v1 endpoint
# DROPS it — so the server-side value below is the one that actually takes effect.
# Too small = the agent "forgets" its system prompt and hallucinates a generic chatbot.
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_KEEP_ALIVE=30m
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:3b

# --------------------------------------------------------------------------
# Paths / container identity
# --------------------------------------------------------------------------
# The drop zone: put (or symlink) the projects Hermes should know about in here.
# Mounted READ-ONLY at /workspace/projects inside the container.
# Keep this SMALL — indexing your whole ~/Documents/vscode is what made the first
# CPU run take 3 minutes per token.
HERMES_DROPZONE=./hermes_shared_workspace

HERMES_CONTAINER=hermes_local
HERMES_IMAGE=nousresearch/hermes-agent
# Pin a tag (e.g. v0.20.5) in production; `latest` is fine while experimenting.
HERMES_IMAGE_TAG=latest

# --------------------------------------------------------------------------
# Antigravity 2.0 -> Hermes bridge (see .agents/skills/hermes/SKILL.md)
# --------------------------------------------------------------------------
# docker = `docker exec ... hermes -z` (default: no port, no key, works out of the box)
# http   = OpenAI-compatible API server on 127.0.0.1:8642 (faster repeat queries,
#          needs HERMES_API_ENABLED=true + a key)
HERMES_TRANSPORT=docker
HERMES_WORKSPACE=/workspace/projects
HERMES_TIMEOUT=300

# Only needed for HERMES_TRANSPORT=http. Generate: openssl rand -hex 32
HERMES_API_ENABLED=false
HERMES_API_KEY=
HERMES_API_PORT=8642
HERMES_API_URL=http://127.0.0.1:8642/v1

# Optional web dashboard inside the container (loopback-published). 1 = on.
HERMES_DASHBOARD=0
HERMES_DASHBOARD_PORT=9119

# --------------------------------------------------------------------------
# Container sizing
# --------------------------------------------------------------------------
HERMES_MEM_LIMIT=2G
HERMES_CPU_LIMIT=2.0
# Only set these when /opt/data is a BIND MOUNT of a host directory (e.g. ~/.hermes);
# leave them alone for the default named volume, where the image's own user is used.
#HERMES_UID=1000
#HERMES_GID=1000
